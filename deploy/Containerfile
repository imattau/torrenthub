# Build:   podman build --format docker -f deploy/Containerfile -t torrenthub .      (or: docker build -f deploy/Containerfile -t torrenthub .)
#          (--format docker keeps the HEALTHCHECK; podman's default image format has none)
# Run:     podman run -d --name hub -v thub-data:/data \
#            -p 8080:8080 -p 6881:6881/tcp -p 6881:6881/udp \
#            -e THUB_PUBLIC_URL=https://hub.example.org -e THUB_PUBLISH_QUOTA=20G -e THUB_ROOTS=<your public key> torrenthub
#
# The swarm port must be published at the SAME number inside and out (6881:6881), or tell the hub the outside number with
# THUB_SWARM_PUBLIC_PORT. Dependencies are installed at the versions in lock/runtime.txt.

FROM python:3.12-slim AS build
WORKDIR /src
COPY pyproject.toml README.md LICENSE MANIFEST.in ./
COPY torrenthub ./torrenthub
COPY lock ./lock
RUN pip install --no-cache-dir build && python -m build --wheel --outdir /dist

FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /data --shell /usr/sbin/nologin thub \
 && mkdir /data && chown thub /data
COPY --from=build /dist /dist
COPY lock/runtime.txt /lock/runtime.txt
RUN pip install --no-cache-dir -c /lock/runtime.txt "$(ls /dist/*.whl)[swarm,fast,relay]" && rm -rf /dist
ENV THUB_DATA=/data THUB_SWARM=libtorrent THUB_LISTEN_PORT=6881 PYTHONUNBUFFERED=1
USER thub
VOLUME /data
EXPOSE 8080 6881/tcp 6881/udp
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=4).status == 200 else 1)"
ENTRYPOINT ["tini", "--", "torrenthub"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8080"]
