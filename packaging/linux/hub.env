# /etc/torrenthub/hub.env is read by the torrenthub service (systemctl edit torrenthub to override). Every setting is documented in the README.
# The package never overwrites this file once you have edited it.
THUB_PUBLIC_URL=https://hub.example.org
THUB_SWARM=libtorrent
THUB_LISTEN_PORT=6881
# Your public key, so you (and keys you delegate to) may publish here. Nobody can publish while this is empty.
THUB_ROOTS=
# Bytes of published content one signing key may hold. 0 turns publishing off.
THUB_PUBLISH_QUOTA=20G
# Stop mirroring when the data directory reaches this size.
THUB_MAX_DISK=500G
# The reverse proxy is on this machine; this is uvicorn's default, shown so you know it matters for the rate limits.
FORWARDED_ALLOW_IPS=127.0.0.1
